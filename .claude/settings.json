{
  "effortLevel": "high",
  "autoCompactEnabled": true,
  "autoCompactWindow": 500000,
  "enabledMcpjsonServers": ["playwright"],
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.js",
    "padding": 1
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git push:*)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx tsx tools/scripts/generate-table-docs.ts)",
      "Bash(npx tsx tools/export-to-sql.ts)"
    ],
    "ask": [
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(*prisma migrate*)",
      "Bash(*prisma db push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development*)",
      "Read(./.env.production*)",
      "Read(./.env.test*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(*prisma migrate reset*)",
      "Read(//mnt/**)",
      "Edit(//mnt/**)",
      "Write(//mnt/**)",
      "Bash(*/mnt/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start-context.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact-save.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*prisma migrate*)",
            "command": "node .claude/hooks/pre-migrate-backup.js",
            "timeout": 60,
            "statusMessage": "DB バックアップを実行中..."
          },
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "node .claude/hooks/pre-commit-type-check.js",
            "timeout": 120,
            "statusMessage": "型チェックを実行中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "node .claude/hooks/post-commit-doc-check.js",
            "timeout": 10,
            "statusMessage": "設計書同期を確認中..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(src/**/*.{ts,tsx})",
            "command": "node .claude/hooks/post-edit-lint.js",
            "timeout": 30,
            "statusMessage": "lint 自動修正中..."
          },
          {
            "type": "command",
            "if": "Write(src/**/*.{ts,tsx})",
            "command": "node .claude/hooks/post-edit-lint.js",
            "timeout": 30,
            "statusMessage": "lint 自動修正中..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/subagent-stop-diff.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
